{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/r/:codigo",
      "destination": "/api/og-share?tipo=convite&id=:codigo"
    },
    {
      "source": "/c/:token",
      "destination": "/api/og-share?tipo=contrato&id=:token"
    },
    {
      "source": "/t/:token",
      "destination": "/api/og-share?tipo=testemunha&id=:token"
    },
    {
      "source": "/i/:id",
      "destination": "/api/og-share?tipo=imovel&id=:id"
    },
    {
      "source": "/p/curso/:id",
      "destination": "/api/og-share?tipo=curso&id=:id"
    },
    {
      "source": "/p/ebook/:id",
      "destination": "/api/og-share?tipo=ebook&id=:id"
    },
    {
      "source": "/aula/:slug",
      "destination": "/api/og-share?tipo=live&id=:slug"
    },
    {
      "source": "/leiloes",
      "destination": "/api/publico?tipo=brasil"
    },
    {
      "source": "/leiloes/buscar",
      "destination": "/api/publico?tipo=busca"
    },
    {
      "source": "/leiloes/:uf",
      "destination": "/api/publico?tipo=uf&uf=:uf"
    },
    {
      "source": "/leiloes/:uf/:cidade",
      "destination": "/api/publico?tipo=cidade&uf=:uf&cidade=:cidade"
    },
    {
      "source": "/leilao/:id",
      "destination": "/api/publico?tipo=imovel&id=:id"
    },
    {
      "source": "/leilao/:id/:slug",
      "destination": "/api/publico?tipo=imovel&id=:id"
    },
    {
      "source": "/sitemap-hubs.xml",
      "destination": "/api/sitemap-leiloes?p=0"
    },
    {
      "source": "/sitemap-leiloes.xml",
      "destination": "/api/sitemap-leiloes"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://bidprobrasil.com.br"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, GET, PATCH, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization, Content-Type, X-Leiloeiro-Key, X-Cron-Secret"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://bzrcdn.openai.com https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://connect.facebook.net https://sdk.mercadopago.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: http:; connect-src 'self' https://*.openai.com https://bzrcdn.openai.com https://*.supabase.co wss://*.supabase.co https://api.anthropic.com https://api.daily.co wss://*.daily.co https://nominatim.openstreetmap.org https://servicodados.ibge.gov.br https://viacep.com.br https://api.resend.com https://api.asaas.com https://api.mercadopago.com https://sdk.mercadopago.com https://overpass-api.de https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.googleadservices.com https://*.doubleclick.net https://www.google.com https://connect.facebook.net https://www.facebook.com https://api.portaldatransparencia.gov.br; frame-src 'self' blob: https://*.daily.co https://*.mercadopago.com https://*.supabase.co https://td.doubleclick.net https://www.facebook.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://iframe.mediadelivery.net https://*.pandavideo.com.br; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ],
