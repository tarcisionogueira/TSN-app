{
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/$1" }],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://bidprobrasil.com.br" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, GET, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type, X-Leiloeiro-Key, X-Cron-Secret" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://sdk.mercadopago.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: http:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.anthropic.com https://api.daily.co wss://*.daily.co https://nominatim.openstreetmap.org https://servicodados.ibge.gov.br https://viacep.com.br https://api.resend.com https://api.asaas.com https://api.mercadopago.com https://sdk.mercadopago.com https://overpass-api.de https://www.google-analytics.com https://api.portaldatransparencia.gov.br; frame-src https://*.daily.co https://*.mercadopago.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/health-check",        "schedule": "0 6 * * *"    },
    { "path": "/api/enviar-alertas-cron", "schedule": "0 11 * * *"   },
    { "path": "/api/geocodificar",        "schedule": "*/10 * * * *"  },
    { "path": "/api/onr-health",          "schedule": "0 7 * * 1"    },
    { "path": "/api/renovacao-avisos-cron", "schedule": "0 9 * * *"    },
    { "path": "/api/scraper-transparencia",    "schedule": "0 3 * * *"    },
    { "path": "/api/financiamento-alertas-cron","schedule": "0 7 * * *"    },
    { "path": "/api/limpar-documentos-cron",  "schedule": "0 2 * * *"    },
    { "path": "/api/gerar-slots",             "schedule": "0 1 * * *"    },
    { "path": "/api/cnj-monitor-cron",        "schedule": "0 10 * * *"   },
    { "path": "/api/juridico-lembretes-cron", "schedule": "0 12 * * 1-5" },
    { "path": "/api/limpar-analises-cron",    "schedule": "0 4 * * *"    },
    { "path": "/api/limpar-imoveis-stale-cron","schedule": "0 5 * * *"    },
    { "path": "/api/enriquecer-proximidades", "schedule": "*/15 * * * *" },
    { "path": "/api/reconciliar-assinaturas-cron", "schedule": "30 * * * *"   },
    { "path": "/api/cancelar-nao-pagos-cron",     "schedule": "0 */6 * * *"  },
    { "path": "/api/monitor-fontes-cron",         "schedule": "0 11 * * *"   },
    { "path": "/api/laudo-retry-cron",            "schedule": "0 */2 * * *"  },
    { "path": "/api/monitor-dados-cron",          "schedule": "0 9 * * *"    },
    { "path": "/api/enriquecer-datas-cron",       "schedule": "0 13,20 * * *" },
    { "path": "/api/regeocod-imprecisos",         "schedule": "0 */6 * * *" },
    { "path": "/api/diagnostico-ia?forcar=1",     "schedule": "0 11 * * *" },
    { "path": "/api/enriquecer-backfill-cron",    "schedule": "30 16 * * *" },
    { "path": "/api/documental-retry-cron",       "schedule": "0 * * * *"    },
    { "path": "/api/moderador-cron",              "schedule": "0 8 * * 1"    },
    { "path": "/api/reconciliar-asaas-cron",      "schedule": "45 */6 * * *" },
    { "path": "/api/seguranca-auditoria-cron",    "schedule": "15 5 * * 1"   }
  ]
}
