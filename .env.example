# Chave da Anthropic — SEMPRE server-side (nunca com prefixo VITE_, senão vaza no
# bundle do front). Defina CLAUDE_KEY no painel da Vercel e no .env local de dev.
CLAUDE_KEY=sk-ant-...

# Fase 2 — Backend
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# VITE_ASAAS_ENV=sandbox

# WhatsApp da empresa para o botão "Falar no WhatsApp" no chat de suporte.
# Preencher SÓ quando a integração do WhatsApp gerar o número (formato internacional,
# só dígitos, ex.: 5571999999999). Vazio = botão oculto (nada muda no chat atual).
# VITE_WHATSAPP_NUMERO=

# Turnstile (Cloudflare) no cadastro (16/09) — SITE KEY é pública, vai no front.
# Vazio = widget não aparece e o cadastro funciona como antes (rollout seguro).
# A SECRET KEY correspondente NÃO entra aqui — só no painel do Supabase
# (Authentication → Settings → Bot and Abuse Protection), nunca versionada.
# VITE_TURNSTILE_SITE_KEY=
